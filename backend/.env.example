PORT=5000
NODE_ENV=development

# MongoDB (local) - or paste your MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/edusphere

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1h

# Frontend URL(s) allowed by CORS + Socket.IO (comma separated)
CLIENT_URL=http://localhost:5173

# Needed to register an ADMIN account (type this key on the admin registration form)
ADMIN_REGISTRATION_KEY=replace_with_a_secret_admin_key

# Used only by `npm run seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345
